# ============================================
# AI20K Project — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- 1. Application Configuration ----
APP_NAME="AI20K Agent System"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# ---- 2. Database Configuration (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=ai20k_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai20k_db

# ---- 3. Redis Configuration ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 4. Security Configuration ----
SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 5. LLM Configuration ----
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
MAX_TOKENS=2048
# Thời gian chờ tối đa một lời gọi LLM (giây) — NFR2 yêu cầu re-prompt dưới 15 giây
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---- 6. Agent Configuration ----
AGENT_MAX_ITERATIONS=10
CHROMA_PERSIST_DIR=./data/chroma
ENABLE_HUMAN_IN_THE_LOOP=true
# Che thông tin cá nhân trước khi gửi lên LLM (FR6.2) — chỉ tắt khi cần gỡ lỗi
PII_MASKING_ENABLED=true

# ---- 7. Observability Configuration ----
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent

# ---- 8. CORS Configuration ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log
