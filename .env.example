# ============================================
# AI20K Project â€” Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- 1. Application Configuration ----
APP_NAME="AI20K Agent System"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# ---- 2. Database Configuration (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=ai20k_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai20k_db
DATABASE_ECHO=false
MVP_ACTOR_ID=a678ac27-3077-5ef2-8919-5218b2e48791
MVP_ACTOR_USERNAME=annv
MVP_ACTOR_EMAIL=an.nguyen@dataworks.vn
UPLOAD_DIR=data/uploads

# ---- 3. Redis Configuration ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 4. Security Configuration ----
SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 5. LLM Configuration ----
LLM_PROVIDER_PRIORITY=OPENAI
# Provider-specific keys có thể dùng CSV hoặc JSON array. Explicit provider luôn thắng prefix.
OPENAI_API_KEYS=sk-example-key-1,sk-example-key-2
# GEMINI_API_KEYS=AIza-example-key
# ANTHROPIC_API_KEYS=sk-ant-example-key
# Generic credentials chỉ dùng khi cần auto-detect provider theo prefix.
# LLM_API_KEYS=sk-ant-example-key,sk-example-key,AIza-example-key
OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_SUMMARY_MODEL=
# GEMINI_SUMMARY_MODEL=
# ANTHROPIC_SUMMARY_MODEL=
LLM_BASE_URL=
# [Option A] Local LLM (Ollama - e.g., Qwen2.5-Coder 14B / Gemma 2 9B / Mistral NeMo 12B)
# OPENAI_API_KEYS=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5-coder:14b

# [Option B] Cloud LLM (OpenAI / OpenRouter)
# Các biến đơn dưới đây chỉ còn phục vụ migration single-provider.
LLM_PROVIDER=
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_API_KEY=
MODEL_NAME=gpt-4o-mini
ANTHROPIC_BASE_URL=
LLM_TEMPERATURE=0.0
# Thời gian chờ tối đa một lời gọi LLM (giây) — NFR2 yêu cầu re-prompt dưới 15 giây
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_CREDENTIAL_COOLDOWN_SECONDS=60
LLM_PROVIDER_FAILURE_THRESHOLD=2
LLM_PROVIDER_COOLDOWN_SECONDS=30

# ---- 6. Agent Operation Configuration ----
# Trần token cho một operation — phải đủ lớn để xuất trọn schema JSON/DBML.
AGENT_MAX_OUTPUT_TOKENS=8000
STRUCTURED_OUTPUT_MAX_ATTEMPTS=3
CONVERSATION_CONTEXT_WINDOW_TOKENS=32768
CONVERSATION_RECENT_TURNS=6
CONVERSATION_SUMMARY_BATCH_SIZE=4
CONVERSATION_TOKEN_CHARS_PER_TOKEN=4.0
CONVERSATION_PROJECT_CONTEXT_SOFT_TARGET=0.45
CONVERSATION_SUMMARY_SOFT_TARGET=0.10
CONVERSATION_HISTORY_SOFT_TARGET=0.20
CONVERSATION_SUMMARY_MODEL_NAME=
CONVERSATION_SUMMARY_TEMPERATURE=0.1
CONVERSATION_SUMMARY_MAX_OUTPUT_TOKENS=1500
# Che thông tin cá nhân trước khi gửi lên LLM (FR6.2) — chỉ tắt khi cần gỡ lỗi
PII_MASKING_ENABLED=true
PII_DEFAULT_LANGUAGE=vi
PII_SUPPORTED_LANGUAGES=vi,en,ja
PII_SCORE_THRESHOLD=0.4

# ---- 7. Observability Configuration ----
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent

# ---- 8. CORS Configuration ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
